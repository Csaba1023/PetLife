# Petavira – biztonsági fejlécek (Cloudflare Workers statikus fájlok; a fájl maga nem töltődik le)
# CSP: csak a saját cím, a Supabase, a Google Fonts és a Turnstile robotszűrő (challenges.cloudflare.com) érhető el. Az 'unsafe-inline' azért kell,
# mert az app kódja egyetlen inline scriptben van (később külön fájlba tehető, és akkor kivehető).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://vxinkrltltlfcgjhoqqj.supabase.co https://fonts.googleapis.com https://fonts.gstatic.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin
